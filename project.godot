; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; goes between []
;   param=value ; assign values to parameters
;
; Scaffold created 2026-10-01 (see docs/PROJECT_STRUCTURE.md).

config_version=5

[application]

config/name="RoadPilot"
config/description="A lightweight 3D bus simulator with a teaching-focused Auto Drive feature."
run/main_scene="res://src/core/core.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/stretch/mode="disabled"

